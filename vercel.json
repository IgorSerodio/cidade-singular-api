{
    "version": 2,
    "builds": [
      {
        "src": "index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/",
            "methods": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS"
            ]
        }
    ],
    "installCommand": "npm install && npm install mongoose@5.11.13 --legacy-peer-deps && npm install mongoose-unique-validator@2.0.3 --legacy-peer-deps"
  }